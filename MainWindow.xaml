<Window x:Class="Papochka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Papochka"
        mc:Ignorable="d"
        Title=""  WindowStyle="None" AllowsTransparency="True" 
        ShowInTaskbar="False" Background="Transparent"
        SizeToContent="WidthAndHeight" Deactivated="Window_Deactivated" Loaded="Window_Loaded"
        ResizeMode="NoResize">
    <Grid>

        <StackPanel Width="{Binding MiniOuterWidth}" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Border Width="{Binding MiniBoxWidth}" Height="{Binding MiniBoxHeight}" 
                    Background="{Binding FolderBackgroundBrush}" CornerRadius="16" Padding="7" Cursor="Hand" 
                    AllowDrop="True" Drop="Border_Drop" 
                    MouseLeftButtonDown="Border_MouseLeftButtonDown" 
                    MouseMove="Border_MouseMove" 
                    MouseEnter="Border_MouseEnter"
                    MouseLeftButtonUp="Border_MouseLeftButtonUp"
                    MouseRightButtonUp="MiniFolder_RightClick">
                <ItemsControl ItemsSource="{Binding PrevItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding MiniPreviewRows}" Columns="{Binding MiniPreviewCols}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding Icon}" 
                                   Width="{Binding DataContext.MiniIconSize, RelativeSource={RelativeSource AncestorType=Window}}" 
                                   Height="{Binding DataContext.MiniIconSize, RelativeSource={RelativeSource AncestorType=Window}}" 
                                   Margin="2" MouseLeftButtonUp="MiniItem_MouseUp"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="{Binding FolderName}" Foreground="White" FontSize="11" 
               TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,3,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowFolderName}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9" Color="Black"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>


        <Border Height="{Binding ExpandedSize}" Width="{Binding ExpandedSize}" 
                Background="{Binding FolderBackgroundBrush}" CornerRadius="10" Padding="10"
                AllowDrop="True" Drop="Border_Drop" 
                MouseLeftButtonDown="Border_MouseLeftButtonDown" 
                MouseMove="Border_MouseMove" 
                MouseLeave="Border_MouseLeave"
                MouseRightButtonUp="BigBorder_RightClick"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="TitleBox" Grid.Row="0" 
                         Text="{Binding FolderName, UpdateSourceTrigger=PropertyChanged}" 
                         Background="Transparent" Foreground="White" BorderThickness="0"
                         FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                         TextAlignment="Center" Margin="0,2,0,10" CaretBrush="White"
                         MaxLength="25" 
                         PreviewMouseLeftButtonDown="TitleBox_MouseDown"
                         LostKeyboardFocus="TitleBox_LostFocus"
                         KeyDown="TitleBox_KeyDown">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FolderName}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowFolderName}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>


                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="82" Margin="4" Padding="4,6" CornerRadius="8" Background="Transparent" Cursor="Hand" 
                                        AllowDrop="True" MouseLeftButtonDown="Tile_MouseDown" MouseMove="Tile_MouseMove"
                                        MouseRightButtonUp="Tile_RightClick" MouseLeftButtonUp="Tile_MouseUp">
                                    <StackPanel>
                                        <Image Source="{Binding Icon}" Width="32" Height="32"/>
                                        <TextBlock Text="{Binding Name}" Foreground="#FFFDFBFB" Margin="0,6,0,0" 
                                   TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Grid>
        </Border>
    </Grid>
</Window>