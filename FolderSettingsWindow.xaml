<Window x:Class="Papochka.FolderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Papochka"
        mc:Ignorable="d"
        Title="Настройки папки" Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="White" Topmost="True" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Focusable="True">
    <Window.Resources>
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#33000000"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#55000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#77000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{Binding FolderBackgroundBrush}" BorderBrush="#444444" BorderThickness="1" CornerRadius="16" Padding="18">
        <StackPanel>
            <TextBlock Text="Настройки папки" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <!-- Встроенный цветовой квадрат + полоса яркости -->
            <Grid Height="150" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="22"/>
                </Grid.ColumnDefinitions>

                <!-- Квадрат Оттенок (X) и Насыщенность (Y) -->
                <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True" BorderBrush="#555555" BorderThickness="1">
                    <Canvas x:Name="SatHueCanvas" Background="Transparent" Cursor="Cross"
                            MouseLeftButtonDown="SatHue_MouseDown" MouseMove="SatHue_MouseMove" MouseLeftButtonUp="Picker_MouseUp">
                        <!-- Горизонтальный спектр оттенков (Hue) -->
                        <Rectangle Width="{Binding ActualWidth, ElementName=SatHueCanvas}" 
                                   Height="{Binding ActualHeight, ElementName=SatHueCanvas}">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF0000" Offset="0.00"/>
                                    <GradientStop Color="#FFFF00" Offset="0.17"/>
                                    <GradientStop Color="#00FF00" Offset="0.33"/>
                                    <GradientStop Color="#00FFFF" Offset="0.50"/>
                                    <GradientStop Color="#0000FF" Offset="0.67"/>
                                    <GradientStop Color="#FF00FF" Offset="0.83"/>
                                    <GradientStop Color="#FF0000" Offset="1.00"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Вертикальный переход в серый (Saturation -> 0) -->
                        <Rectangle Width="{Binding ActualWidth, ElementName=SatHueCanvas}" 
                                   Height="{Binding ActualHeight, ElementName=SatHueCanvas}" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00808080" Offset="0"/>
                                    <GradientStop Color="#FF808080" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Курсор выбора на квадрате -->
                        <Ellipse x:Name="SatHueCursor" Width="10" Height="10" Stroke="White" StrokeThickness="1.5" 
                                 Fill="#44000000" IsHitTestVisible="False" Canvas.Left="0" Canvas.Top="135"/>
                    </Canvas>
                </Border>

                <!-- Вертикальная полоса яркости (Value) -->
                <Border Grid.Column="2" CornerRadius="6" ClipToBounds="True" BorderBrush="#555555" BorderThickness="1">
                    <Canvas x:Name="ValCanvas" Cursor="SizeNS"
                            MouseLeftButtonDown="Val_MouseDown" MouseMove="Val_MouseMove" MouseLeftButtonUp="Picker_MouseUp">
                        <Rectangle Width="{Binding ActualWidth, ElementName=ValCanvas}" 
                                   Height="{Binding ActualHeight, ElementName=ValCanvas}">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                    <GradientStop x:Name="ValPureColorStop" Color="#FF1E1E1E" Offset="0.5"/>
                                    <GradientStop Color="#FF000000" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Ползунок яркости -->
                        <Rectangle x:Name="ValCursor" Width="22" Height="4" Fill="White" Stroke="Black" StrokeThickness="0.8"
                                   IsHitTestVisible="False" Canvas.Top="130"/>
                    </Canvas>
                </Border>
            </Grid>

            <!-- HEX-код -->
            <DockPanel Margin="0,0,0,14">
                <TextBlock Text="HEX-код:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                <TextBox Text="{Binding BgColor, UpdateSourceTrigger=PropertyChanged}" 
                         Background="#33000000" Foreground="White" BorderBrush="#555555" Padding="6,3"/>
            </DockPanel>
            
            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="Название:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                <TextBox Text="{Binding FolderName, UpdateSourceTrigger=PropertyChanged}" 
                         MaxLength="25" Background="#33000000" Foreground="White" BorderBrush="#555555" 
                         Padding="6,4" VerticalContentAlignment="Center"
                         PreviewMouseLeftButtonDown="NameInput_MouseDown"/>
            </DockPanel>


            <!-- Прозрачность -->
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Прозрачность фона" Foreground="#CCCCCC"/>
                <TextBlock Text="{Binding BgOpacity, StringFormat={}{0:P0}}" HorizontalAlignment="Right" Foreground="#CCCCCC"/>
            </DockPanel>
            <Slider Minimum="0.2" Maximum="1.0" TickFrequency="0.01" IsSnapToTickEnabled="True" PreviewMouseLeftButtonDown="Slider_MouseDown"
                    Value="{Binding BgOpacity}" Margin="0,0,0,14"/>
            
            
            <DockPanel Margin="0,0,0,14">
                <TextBlock Text="Свернутая папка (ячейки):" VerticalAlignment="Center" Foreground="#CCCCCC"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox Text="{Binding MiniCols, UpdateSourceTrigger=PropertyChanged}" 
                            Width="36" Padding="4,3" TextAlignment="Center" MaxLength="2"
                             Background="#33000000" Foreground="White" BorderBrush="#555555"
                             PreviewTextInput="NumberOnly_PreviewTextInput"
                             PreviewMouseLeftButtonDown="MiniSizeInput_MouseDown"
                             PreviewMouseWheel="MiniSize_MouseWheel"
                             x:Name="MiniColsBox"/>

                    <TextBlock Text="×" VerticalAlignment="Center" Margin="6,0" Foreground="#AAAAAA"/>

                    <TextBox Text="{Binding MiniRows, UpdateSourceTrigger=PropertyChanged}" 
                             Width="36" Padding="4,3" TextAlignment="Center" MaxLength="2"
                             Background="#33000000" Foreground="White" BorderBrush="#555555"
                             PreviewTextInput="NumberOnly_PreviewTextInput"
                             PreviewMouseLeftButtonDown="MiniSizeInput_MouseDown"
                             PreviewMouseWheel="MiniSize_MouseWheel"
                             x:Name="MiniRowsBox"/>
                </StackPanel>
            </DockPanel>

            <CheckBox Content="Раскрывать при наведении курсора" 
          IsChecked="{Binding ExpandOnHover}"
          Foreground="#CCCCCC" Margin="0,0,0,8" Cursor="Hand"
          PreviewMouseLeftButtonDown="CheckBox_MouseDown"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="55"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Открытие (мс):" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12"/>
                <TextBox x:Name="OpenDelayBox" Grid.Column="1" Text="{Binding HoverOpenDelayMs, UpdateSourceTrigger=PropertyChanged}"
                         TextAlignment="Center" Background="#33000000" Foreground="White" BorderBrush="#555555" Padding="2"
                         PreviewMouseLeftButtonDown="MiniSizeInput_MouseDown" PreviewMouseWheel="DelayInput_MouseWheel"/>

                <TextBlock Grid.Column="3" Text="Закрытие (мс):" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12"/>
                <TextBox x:Name="CloseDelayBox" Grid.Column="4" Text="{Binding HoverCloseDelayMs, UpdateSourceTrigger=PropertyChanged}"
                         TextAlignment="Center" Background="#33000000" Foreground="White" BorderBrush="#555555" Padding="2"
                         PreviewMouseLeftButtonDown="MiniSizeInput_MouseDown" PreviewMouseWheel="DelayInput_MouseWheel"/>
            </Grid>


            <CheckBox Content="Запускать ярлыки прямо из свернутой папки" 
                      IsChecked="{Binding QuickLaunchFromMini}"
                      Foreground="#CCCCCC" Margin="0,0,0,14" Cursor="Hand"
                      PreviewMouseLeftButtonDown="CheckBox_MouseDown"/>
            
            <CheckBox Content="Показывать название папки" 
                       IsChecked="{Binding ShowFolderName}"
                       Foreground="#CCCCCC" Margin="0,0,0,14" Cursor="Hand"
                       PreviewMouseLeftButtonDown="CheckBox_MouseDown"/>


            <!-- Размер раскрытой папки -->
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Размер окна папки" Foreground="#CCCCCC"/>
                <TextBlock Text="{Binding ExpandedSize, StringFormat={}{0:0} px}" HorizontalAlignment="Right" Foreground="#CCCCCC"/>
            </DockPanel>
            <Slider Minimum="300" Maximum="650" TickFrequency="25" IsSnapToTickEnabled="True" PreviewMouseLeftButtonDown="Slider_MouseDown"
                    Value="{Binding ExpandedSize}" Margin="0,0,0,16"/>

            <!-- Кнопки Сбросить и Готово -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/><!--<ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>-->
                    
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Сбросить" Height="32" Background="#33000000" Foreground="#DDDDDD" 
                        BorderBrush="#555555" BorderThickness="1" Cursor="Hand" Click="Reset_Click" Style="{StaticResource DarkButtonStyle}"/>

                <Button x:Name="UndoButton" Grid.Column="2" Content="Отменить" Height="32" Background="#33000000" Foreground="#DDDDDD" 
                        BorderBrush="#555555" BorderThickness="1" Cursor="Hand" IsEnabled="False" Click="Undo_Click" Style="{StaticResource DarkButtonStyle}"/>

                <!--<Button Grid.Column="4" Content="Готово" Height="32" Background="#44FFFFFF" Foreground="White" 
            BorderThickness="0" Cursor="Hand" Click="Close_Click" Style="{StaticResource DarkButtonStyle}"/>-->
            </Grid>

        </StackPanel>
    </Border>
</Window>
